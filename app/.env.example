# Copier en .env.local pour surcharger en local.
EXPO_PUBLIC_API_URL=https://trainwise-backend-rnd4.onrender.com

# Version web en local : l'API de production refuse l'origine localhost.
# Lancer `node scripts/dev-api-proxy.mjs` puis décommenter la ligne suivante.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:8787

# 1 = bouton « Explorer la démo » sur l'écran de connexion dans un build (toujours actif en développement).
EXPO_PUBLIC_DEMO=0

# Connexion Google : identifiants OAuth créés dans Google Cloud Console.
# Sans ces variables, le bouton Google reste masqué.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
