<%- include('_header', { title: 'Athlètes du coach', page: 'coaches' }) %>

<div class="page-header" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
  <a href="/coaches" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i></a>
  <div>
    <h1><%= coach.firstName || '' %> <%= coach.lastName || '' %><% if (!coach.firstName && !coach.lastName) { %>Sans nom<% } %></h1>
    <p><%= coach.email %> — <%= relations.length %> relation<%= relations.length > 1 ? 's' : '' %></p>
  </div>
</div>

<% if (saved) { %>
  <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> Plan mis à jour.</div>
<% } %>
<% if (blocked) { %>
  <div class="alert alert-warning"><i class="fa-solid fa-lock"></i> Ce coach paie un abonnement Stripe : son plan ne se change pas depuis ici.</div>
<% } %>

<div class="card" style="margin-bottom:20px;">
  <div class="card-header">
    <span class="card-title"><i class="fa-solid fa-crown" style="color:#b88a00;margin-right:6px;"></i>Abonnement</span>
    <% const pc = planColors[plan.id] || planColors.decouverte; %>
    <span class="badge" style="background:<%= pc.bg %>;color:<%= pc.ink %>;"><%= plan.name %></span>
  </div>
  <div class="card-body">

    <div class="field-list" style="margin-bottom:18px;">
      <div class="field-row">
        <span class="field-label"><i class="fa-solid fa-users"></i> Athlètes suivis</span>
        <span class="field-value" style="<%= plan.athletes !== null && accepted > plan.athletes ? 'color:var(--danger);font-weight:700;' : '' %>">
          <%= accepted %><%= plan.athletes === null ? ' (sans limite)' : ' / ' + plan.athletes %>
        </span>
      </div>
      <div class="field-row">
        <span class="field-label"><i class="fa-solid fa-layer-group"></i> Groupes</span>
        <span class="field-value"><%= groupCount %><%= plan.groups === null ? ' (sans limite)' : ' / ' + plan.groups %></span>
      </div>
      <div class="field-row">
        <span class="field-label"><i class="fa-solid fa-bell"></i> Alertes sur mesure</span>
        <span class="field-value"><%= plan.customAlerts ? 'Oui' : 'Non' %></span>
      </div>
      <div class="field-row">
        <span class="field-label"><i class="fa-solid fa-circle-info"></i> État</span>
        <span class="field-value">
          <%= statusLabels[billing.status] || 'Actif' %><% if (granted) { %> — posé depuis le back-office<% } else if (billing.subscriptionId) { %> — abonnement Stripe<% } %>
        </span>
      </div>
      <% if (billing.currentPeriodEnd) { %>
      <div class="field-row">
        <span class="field-label"><i class="fa-solid fa-calendar"></i> Jusqu'au</span>
        <span class="field-value"><%= new Date(billing.currentPeriodEnd).toLocaleDateString('fr-FR', { day:'2-digit', month:'long', year:'numeric' }) %></span>
      </div>
      <% } %>
    </div>

    <% if (billing.subscriptionId) { %>
      <div class="alert alert-warning" style="margin:0;">
        <i class="fa-solid fa-lock"></i>
        Ce coach a un abonnement Stripe en cours. Il se modifie depuis Stripe, pas d'ici : le prochain webhook écraserait le réglage et le coach continuerait d'être prélevé.
      </div>
    <% } else { %>
      <form method="POST" action="/coaches/<%= coach._id %>/plan">
        <p style="font-size:0.72rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:12px;">Poser un plan à la main</p>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Plan</label>
            <select name="planId" class="form-control">
              <% plans.forEach(p => { %>
                <option value="<%= p.id %>" <%= plan.id === p.id ? 'selected' : '' %>>
                  <%= p.name %><%= p.monthly ? ' — ' + p.monthly + ' €/mois' : ' — gratuit' %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Facturation affichée</label>
            <select name="cycle" class="form-control">
              <option value="monthly" <%= billing.cycle !== 'yearly' ? 'selected' : '' %>>Mensuelle</option>
              <option value="yearly" <%= billing.cycle === 'yearly' ? 'selected' : '' %>>Annuelle</option>
            </select>
          </div>
          <div class="form-group full">
            <label class="form-label">Jusqu'au <span style="color:var(--text-muted);font-weight:400;text-transform:none;letter-spacing:0;">(vide = sans échéance)</span></label>
            <input type="date" name="until" class="form-control" value="<%= billing.currentPeriodEnd ? new Date(billing.currentPeriodEnd).toISOString().slice(0,10) : '' %>">
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-save"><i class="fa-solid fa-check"></i> Enregistrer</button>
        </div>
        <p class="text-small text-muted" style="margin-top:10px;">
          Aucun paiement n'est créé : le plan est simplement offert. Le coach garde la possibilité de souscrire pour de vrai, ce qui remplacera ce réglage.
        </p>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Athlète</th><th>Statut</th><th>Package</th><th>Invité le</th></tr>
      </thead>
      <tbody>
        <% relations.forEach(r => { %>
        <tr>
          <td>
            <% if (r.athlete) { %>
            <a href="/users/<%= r.athlete._id %>" class="table-link" style="display:flex;align-items:center;gap:10px;">
              <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#00a6fb,#0582ca);display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.78rem;font-weight:700;flex-shrink:0;">
                <%= (r.athlete.firstName || r.athlete.email || '?')[0].toUpperCase() %>
              </div>
              <div>
                <div style="font-weight:500;font-size:0.84rem;"><%= r.athlete.firstName || '' %> <%= r.athlete.lastName || '' %></div>
                <div class="text-small text-muted"><%= r.athlete.email %></div>
              </div>
            </a>
            <% } else { %><span class="text-muted">Compte supprimé</span><% } %>
          </td>
          <td>
            <span class="badge" style="background:<%= r.status === 'accepted' ? 'rgba(16,185,129,0.1)' : r.status === 'pending' ? 'rgba(245,158,11,0.1)' : 'rgba(239,68,68,0.1)' %>;color:<%= r.status === 'accepted' ? '#059669' : r.status === 'pending' ? '#d97706' : '#ef4444' %>;">
              <%= r.status === 'accepted' ? '✓ Accepté' : r.status === 'pending' ? '⏳ En attente' : '✗ Refusé' %>
            </span>
          </td>
          <td>
            <% const pkgColors = { invited: '#7c3aed', bronze: '#b8722d', silver: '#737373', gold: '#b88a00' }; %>
            <% const pkgBg     = { invited: 'rgba(124,58,237,0.10)', bronze: 'rgba(205,127,50,0.12)', silver: 'rgba(168,168,168,0.18)', gold: 'rgba(255,215,0,0.18)' }; %>
            <% const currentPkg = r.packageType || 'silver'; %>
            <form method="POST" action="/coaches/<%= coach._id %>/relations/<%= r._id %>/package" style="margin:0;">
              <select name="packageType" onchange="this.form.submit()" style="text-transform:capitalize;font-weight:600;font-size:0.78rem;padding:0.25rem 0.5rem;border-radius:8px;border:1px solid rgba(0,0,0,0.08);cursor:pointer;background:<%= pkgBg[currentPkg] %>;color:<%= pkgColors[currentPkg] %>;">
                <% ['invited','bronze','silver','gold'].forEach(p => { %>
                  <option value="<%= p %>" <%= currentPkg === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option>
                <% }); %>
              </select>
            </form>
          </td>
          <td class="text-muted text-small"><%= new Date(r.invitedAt || r.createdAt).toLocaleDateString('fr-FR', { day:'2-digit', month:'short', year:'numeric' }) %></td>
        </tr>
        <% }); %>
        <% if (!relations.length) { %>
        <tr><td colspan="4"><div class="empty-state"><i class="fa-solid fa-users"></i><p>Aucun athlète</p></div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('_footer') %>
